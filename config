# Monara Linux Build Configuration
# Source this file from build scripts

# Distro info
DISTRO_NAME="Monara"
DISTRO_VERSION="0.1.0"
DISTRO_CODENAME="Proto"

# Build parallelism
JOBS=$(nproc)

# ============================================================
# CPU Baseline
# Set to "native" for -march=native (fastest for your CPU)
# Set to "x86-64-v3" for AVX2/BMI/FMA (Clear Linux baseline)
# Set to "x86-64-v4" for AVX-512
# ============================================================
CPU_BASELINE="native"

if [ "$CPU_BASELINE" = "native" ]; then
    MARCH="-march=native -mtune=native"
else
    MARCH="-march=$CPU_BASELINE -mtune=$CPU_BASELINE"
fi

# ============================================================
# Compiler flags - Clear Linux inspired aggressive optimization
# ============================================================
OPT_LTO="-flto=auto -fdevirtualize-at-ltrans"

CFLAGS="-O3 $MARCH -pipe -fomit-frame-pointer -ftree-vectorize -fno-semantic-interposition -fstack-protector-strong $OPT_LTO"
CXXFLAGS="$CFLAGS"
LDFLAGS="-Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,now"
MAKEFLAGS="-j$JOBS"

# Kernel build flags (override kernel default -O2 with -O3)
KCFLAGS="-O3 -fno-semantic-interposition"
KCPPFLAGS=""

# Target architecture
ARCH="x86_64"
CROSS_COMPILE=""

# Directory layout
MONARA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCES_DIR="$MONARA_DIR/sources"
CACHE_DIR="$MONARA_DIR/cache"
ROOTFS_DIR="$MONARA_DIR/rootfs"
OVERLAY_DIR="$MONARA_DIR/rootfs-overlay"
PKG_DIR="$MONARA_DIR/pkg"
ISO_DIR="$MONARA_DIR/iso"
SCRIPTS_DIR="$MONARA_DIR/scripts"

